# 复制本文件为 .env，填入自己的 Key（.env 已在 .gitignore 里，不会被提交）

# ---------------- 大模型接口（任何 OpenAI 兼容服务都能用）----------------
# 默认：DeepSeek，deepseek-flash 支持看图
VLM_API_KEY=你的Key
VLM_BASE_URL=https://api.deepseek.com
VLM_MODEL=deepseek-flash

# 换火山方舟（豆包）示例：注释掉上面三行，改用下面三行
# VLM_API_KEY=你的火山方舟 Key
# VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VLM_MODEL=ep-20250101-xxxxx         # 方舟的"接入点 ID"，不是模型名

# 换阿里云百炼（Qwen-VL）示例
# VLM_API_KEY=sk-xxxx
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen-vl-max

# 兼容旧变量名：没写 VLM_* 时会读 DEEPSEEK_*
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ---------------- 其它 ----------------
# 截图设备像素密度（本课题模拟器统一用 480）
# AGEFRIENDLY_DPI=480

# 是否把截图一起发给模型：1=发（默认）；0=只发事实卡，省 token
# AGEFRIENDLY_SEND_IMAGE=1

# 图片精度：high=保留原图；low=压到 512×512（便宜但小字会糊）
# AGEFRIENDLY_IMAGE_DETAIL=high

# OCR 模型缓存目录，服务器不能写用户目录时用
# AGEFRIENDLY_MODEL_DIR=models
