# 复制本文件为 .env，填入自己的 Key（.env 已在 .gitignore 里，不会被提交）

# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里粘贴你的Key

# 模型：deepseek-flash 支持看图；换成 deepseek-chat 会自动退化成只发文字
# DEEPSEEK_MODEL=deepseek-flash

# 截图设备像素密度（本课题模拟器统一用 480）
# AGEFRIENDLY_DPI=480

# 是否把截图一起发给模型：1=发（默认）；0=只发事实卡，省 token
# AGEFRIENDLY_SEND_IMAGE=1

# 图片精度：high=保留原图；low=压到 512×512（便宜但小字会糊）
# AGEFRIENDLY_IMAGE_DETAIL=high

# OCR 模型缓存目录，服务器不能写用户目录时用
# AGEFRIENDLY_MODEL_DIR=models
